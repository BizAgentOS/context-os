{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/agent/**/*.ts",
    "tests/knowledge/**/*.ts",
    "scripts/knowledge/**/*.ts",
    "scripts/live-heating.ts",
    "scripts/context-os-mcp.ts",
    "scripts/dataengine-mcp.ts",
    "scripts/verification/**/*.ts"
  ]
}
