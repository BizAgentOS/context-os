# Copy to .env in the repository root. Do not commit real credentials.
# Existing shell environment variables take precedence over this file.
CONTEXT_OS_KNOWLEDGE_DATABASE_URL=postgresql://context_os:context_os_local@127.0.0.1:5433/context_os_dev
CONTEXT_OS_KNOWLEDGE_PRINCIPALS='[{"id":"developer","role":"admin","token":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"}]'
CONTEXT_OS_KNOWLEDGE_PORT=3211
CONTEXT_OS_KNOWLEDGE_DIRECTORY=local-state/knowledge

# Console + rotating JSON-lines file (single process).
CONTEXT_OS_LOG_LEVEL=info
CONTEXT_OS_LOG_FILE=local-state/logs/context-os.log
CONTEXT_OS_LOG_MAX_BYTES=10485760
CONTEXT_OS_LOG_BACKUPS=5

# Optional model configuration: uncomment and replace all placeholders together.
# CONTEXT_OS_KNOWLEDGE_MODEL_PROVIDER=custom
# CONTEXT_OS_KNOWLEDGE_MODEL=YOUR_MODEL_ID
# CONTEXT_OS_KNOWLEDGE_MODEL_BASE_URL=https://YOUR_PROVIDER/v1
# CONTEXT_OS_KNOWLEDGE_MODEL_PROTOCOL=openai
# CONTEXT_OS_KNOWLEDGE_MODEL_API_KEY=YOUR_API_KEY

# Dedicated empty test database; never point this at the development database.
# CONTEXT_OS_KNOWLEDGE_TEST_DATABASE_URL=postgresql://context_os:context_os_local@127.0.0.1:5433/context_os_test
