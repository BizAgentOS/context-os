{
  "name": "context-os",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/knowledge/server.ts",
    "legacy:start": "node src/agent/server.ts",
    "knowledge:start": "node src/knowledge/server.ts",
    "knowledge:init": "node scripts/knowledge/database.ts init",
    "knowledge:reset": "node scripts/knowledge/database.ts reset-development",
    "knowledge:sample-pdf": "node scripts/knowledge/make-sample-pdf.ts",
    "test:knowledge": "node --test --test-concurrency=1 tests/knowledge/*.test.ts",
    "demo": "node src/demo/server.ts",
    "mcp": "node scripts/context-os-mcp.ts",
    "test": "node --test --test-concurrency=4 tests/agent/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "export:html": "node scripts/export-heating-html.ts",
    "live:demo": "node scripts/live-heating.ts",
    "sources:demo": "node src/live/heating-sources.ts",
    "verify:chain": "node scripts/verification/fusion-chain.ts",
    "verify:snapshots": "node scripts/verification/snapshot-chain.ts",
    "verify:scale": "node scripts/verification/enterprise-scale.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.1",
    "@kodax-ai/kodax": "0.7.96-beta.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@octokit/rest": "22.0.1",
    "csv-parse": "7.0.3",
    "esbuild": "0.28.2",
    "iconv-lite": "0.7.3",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "saxes": "6.0.0",
    "three": "0.186.0",
    "unzipper": "0.12.5",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/unzipper": "0.10.11",
    "exceljs": "4.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    }
  }
}
