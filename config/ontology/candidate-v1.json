  "metrics": [
    {
      "definition": "统计集合中截至查询时点已关闭的投诉条数除以统计集合中的投诉条数。",
      "denominator": "统计集合中的投诉条数",
      "empty_result": "分母为零时返回“无样本”",
      "evidence": [
        {
          "path": "sources/company/service-rules.md",
          "quote": "客服办结率 = 统计集合中截至查询时点已关闭的投诉条数 ÷ 统计集合中的投诉条数。"
        },
        {
          "path": "sources/company/service-rules.md",
          "quote": "统计集合为收到时间落在窗口内、且截至查询时点已经收到的全部投诉单。"
        },
        {
          "path": "sources/company/service-rules.md",
          "quote": "统计窗口采用左闭右开区间，即包括开始时刻、不包括结束时刻；查询时点不得早于窗口结束时刻。"
        }
      ],
      "id": "customer_service_closing_rate",
      "name": "客服办结率",
      "numerator": "已关闭的投诉条数",
      "population": "收到时间落在统计窗口内且截至查询时点已收到的全部投诉单"
    },
    {
      "definition": "同一统计集合中最近一次回访明确改善的投诉条数除以同一集合中有回访结果的投诉条数。",
      "denominator": "有回访结果的投诉条数",
      "empty_result": "分母为零时返回“无样本”",
      "evidence": [
        {
          "path": "sources/company/service-rules.md",
          "quote": "回访确认改善率 = 同一统计集合中最近一次回访明确改善的投诉条数 ÷ 同一集合中有回访结果的投诉条数。"
        },
        {
          "path": "sources/company/service-rules.md",
          "quote": "对每条投诉，只取查询时点之前（含该时点）最近一次已记录的回访结果；这里“有回访结果”包括明确改善、明确未改善、未接通及其他/不确定。未接通计入分母，并在报告中单列条数；其他/不确定也单列。没有回访记录的投诉不计入该分母，须另列“尚未回访”条数。"
        }
      ],
      "id": "callback_confirmed_improvement_rate",
      "name": "回访确认改善率",
      "numerator": "最近一次回访明确改善的投诉条数",
      "population": "统计集合中有回访结果的投诉条数"
    }
  ],
  "open_questions": [
